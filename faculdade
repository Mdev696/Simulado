<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz de Engenharia</title>
    <style>
        :root {
            --primary: #2563eb;
            --success: #059669;
            --danger: #dc2626;
            --bg: #f8fafc;
            --text: #1e293b;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        #quiz-container {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            max-width: 600px;
            width: 100%;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 1rem;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-menu {
            background-color: var(--primary);
            color: white;
        }

        .btn-menu:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        .opcoes-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin: 20px 0;
        }

        .opcao {
            background: #f1f5f9;
            text-align: left;
            border: 2px solid transparent;
        }

        .opcao:hover:not([disabled]) {
            background: #e2e8f0;
        }

        .correta {
            background: var(--success) !important;
            color: white;
        }

        .errada {
            background: var(--danger) !important;
            color: white;
        }

        .hidden {
            display: none;
        }

        #feedback {
            margin-top: 15px;
            padding: 15px;
            border-radius: 6px;
            background: #f0f9ff;
            border-left: 4px solid var(--primary);
        }
    </style>
</head>

<body>

    <div id="quiz-container">
        <!-- Tela Inicial -->
        <div id="home">
            <h1>🎓 Quiz de Engenharia</h1>
            <p>Escolha uma disciplina para começar:</p>
            <div class="menu-grid">
                <button class="btn-menu" onclick="start('embarcados')">Sistemas Embarcados</button>
                <button class="btn-menu" onclick="start('micro')">Microcontroladores</button>
            </div>
        </div>

        <!-- Tela de Questões -->
        <div id="game" class="hidden">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <small id="progresso">Questão 1 de 5</small>
                <strong id="score-display">Score: 0</strong>
            </div>
            <h3 id="pergunta-texto">Texto da Pergunta</h3>
            <div id="opcoes-container" class="opcoes-grid"></div>
            <div id="feedback" class="hidden"></div>
            <button id="btn-proxima" class="btn-menu hidden" style="width: 100%;" onclick="nextQuestion()">Próxima
                Questão</button>
        </div>

        <!-- Tela de Resultado -->
        <div id="result" class="hidden">
            <h2>Fim do Quiz!</h2>
            <p id="resultado-final"></p>
            <button class="btn-menu" onclick="location.reload()">Reiniciar</button>
        </div>
    </div>

    <script>
        const bancoMaster = {
            embarcados: [
                {
                    p: "Como se chama o programa embarcado em microcontroladores que não possui sistema operacional?",
                    o: ["RTOS", "Firmware bare-metal", "Linux RTOS", "Firmware embutido", "Watchdog"],
                    c: 1,
                    e: "Programas que rodam diretamente no hardware sem uma camada de OS são chamados de bare-metal."
                },
                {
                    p: "Qual o requisito de projeto para um sistema que opere sem falhas por um intervalo de tempo especificado?",
                    o: ["Integridade", "Disponibilidade", "Confiabilidade", "Segurança", "Tolerância"],
                    c: 2,
                    e: "Confiabilidade (Reliability) é a probabilidade de um sistema desempenhar sua função sob condições específicas por um período de tempo."
                },
                {
                    p: "Sistemas críticos devem executar em tempo real as respostas aos eventos. Qual é essa característica?",
                    o: ["Confiabilidade", "Determinismo", "Integridade", "Flexibilidade", "Realismo"],
                    c: 1,
                    e: "O determinismo garante que o sistema responda a estímulos dentro de um intervalo de tempo previsível."
                },
                {
                    p: "Segundo o padrão MISRA-C, qual a forma correta de verificar se uma variável A está zerada?",
                    o: ["if (!A)", "if (A == 0)", "if (A != 0)", "if (A = 0)", "if (A > 0)"],
                    c: 1,
                    e: "O MISRA-C exige comparações explícitas para clareza e segurança do código."
                },
                {
                    p: "Sobre V&V (Validação e Verificação), qual afirmativa está correta?",
                    o: ["Verificação é a exatidão do programa final", "Validação é a consistência em cada estágio", "Validação garante que o software implementa uma função específica", "Verificação garante rastreabilidade aos requisitos", "A validação está preocupada em construir o produto certo"],
                    c: 4,
                    e: "Validação responde: 'Estamos construindo o produto certo?' (atende ao cliente). Verificação responde: 'Estamos construindo o produto corretamente?'"
                }
            ],
            micro: [
                {
                    p: "A ALU de um computador normalmente contém uma série de elementos de armazenamento de alta velocidade chamados:",
                    o: ["Contadores", "Registradores", "Células semicondutoras", "Decodificadores", "Controladores"],
                    c: 1,
                    e: "Registradores são memórias de acesso ultra rápido dentro da CPU/ALU para manipulação de dados."
                },
                {
                    p: "Qual a principal vantagem em usar microcontroladores para um projetista?",
                    o: ["Integração de dispositivos dentro do chip", "Facilidade de Assembly", "Desempenho superior aos microprocessadores", "Acionamento direto de altas cargas", "Rodar várias aplicações ao mesmo tempo"],
                    c: 0,
                    e: "A principal vantagem é o 'System on Chip', integrando CPU, memória e periféricos num único componente."
                },
                {
                    p: "Qual a vantagem de usar microcontroladores de 32 bits em relação aos de 8 bits?",
                    o: ["Maior desempenho em operações matemáticas complexas", "Menor custo financeiro", "Mais fáceis de programar em Assembly", "Aumentam exponencialmente os ciclos", "Consomem 4 vezes menos energia"],
                    c: 0,
                    e: "Arquiteturas de 32 bits processam volumes maiores de dados por ciclo, sendo superiores em cálculos complexos."
                },
                {
                    p: "O tempo necessário para a busca e execução de uma simples instrução de máquina é:",
                    o: ["Tempo de busca", "Ciclo de CPU", "Tempo real", "Tempo de máquina", "Ciclo real"],
                    c: 3,
                    e: "O Ciclo de Máquina compreende as etapas de busca (fetch) e execução da instrução."
                },
                {
                    p: "Um microcontrolador deve consistir em pelo menos:",
                    o: ["CPU, RAM, ROM, portas de E/S e temporizadores", "RAM, ROM, portas E/S e temporizadores", "ROM, portas E/S e temporizadores", "CPU, portas E/S e temporizadores", "CPU, RAM, ALU e temporizadores"],
                    c: 0,
                    e: "Esses são os blocos fundamentais para que o sistema seja considerado um microcontrolador funcional."
                },
                {
                    p: "Você tem um ADC de 12 bits com ref de 3,3V. Qual a expressão do valor guardado para uma tensão x?",
                    o: ["x . 4095 / 3,3", "x . 3,3 / 1023", "5 . 4095 / x", "x . 3,3 / 2047", "x . 3,3 / 12"],
                    c: 0,
                    e: "A fórmula é (Ventrada / Vref) * (2^n - 1). Para 12 bits, 2^12-1 = 4095."
                }
            ]
        };

        let currentCategory = [];
        let currentIndex = 0;
        let score = 0;

        function start(cat) {
            currentCategory = bancoMaster[cat];
            currentIndex = 0;
            score = 0;
            document.getElementById('home').classList.add('hidden');
            document.getElementById('game').classList.remove('hidden');
            showQuestion();
        }

        function showQuestion() {
            const questao = currentCategory[currentIndex];
            document.getElementById('progresso').innerText = `Questão ${currentIndex + 1} de ${currentCategory.length}`;
            document.getElementById('pergunta-texto').innerText = questao.p;
            document.getElementById('score-display').innerText = `Score: ${score}`;

            const container = document.getElementById('opcoes-container');
            container.innerHTML = '';

            questao.o.forEach((opt, i) => {
                const btn = document.createElement('button');
                btn.className = 'opcao';
                btn.innerText = opt;
                btn.onclick = () => check(i);
                container.appendChild(btn);
            });

            document.getElementById('feedback').classList.add('hidden');
            document.getElementById('btn-proxima').classList.add('hidden');
        }

        function check(escolha) {
            const questao = currentCategory[currentIndex];
            const botoes = document.querySelectorAll('.opcao');
            const feedback = document.getElementById('feedback');

            botoes.forEach(b => b.disabled = true);

            if (escolha === questao.c) {
                botoes[escolha].classList.add('correta');
                score += 10;
            } else {
                botoes[escolha].classList.add('errada');
                botoes[questao.c].classList.add('correta');
            }

            feedback.innerText = questao.e;
            feedback.classList.remove('hidden');
            document.getElementById('btn-proxima').classList.remove('hidden');
            document.getElementById('score-display').innerText = `Score: ${score}`;
        }

        function nextQuestion() {
            currentIndex++;
            if (currentIndex < currentCategory.length) {
                showQuestion();
            } else {
                showResult();
            }
        }

        function showResult() {
            document.getElementById('game').classList.add('hidden');
            document.getElementById('result').classList.remove('hidden');
            document.getElementById('resultado-final').innerText = `Você completou o quiz com ${score} pontos!`;
        }
    </script>
</body>

</html>